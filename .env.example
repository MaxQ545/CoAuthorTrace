# Coauthor Tracing System Configuration
# Copy this file to .env and modify as needed

# OpenAlex API (optional - provides faster rate limits)
# COAUTHOR_CRAWLER__OPENALEX_EMAIL=your-email@example.com

# Crawler settings
COAUTHOR_CRAWLER__RATE_LIMIT=8.0
COAUTHOR_CRAWLER__BATCH_SIZE=200
COAUTHOR_CRAWLER__MAX_RETRIES=3

# Database settings
COAUTHOR_DATABASE__POSTGRES_URL=postgresql://coauthor:coauthor@localhost:5432/coauthor
COAUTHOR_DATABASE__REDIS_URL=redis://localhost:6379/0
COAUTHOR_DATABASE__REDIS_ENABLED=true

# Scope configuration
# OpenAlex Institution IDs - Find yours at https://openalex.org/
# Example: I16365422 = Hefei University of Technology, I20231570 = Peking University
COAUTHOR_SCOPE__INSTITUTION_IDS=["I16365422"]
# OpenAlex Concept IDs
# C154945302 = AI, C41008148 = Computer Science, C121332964 = Physics
COAUTHOR_SCOPE__CONCEPT_IDS=["C154945302","C41008148"]
COAUTHOR_SCOPE__FROM_DATE=2020-01-01

# Analysis settings
COAUTHOR_ANALYSIS__HIDDEN_DIM=64
COAUTHOR_ANALYSIS__OUTPUT_DIM=32
COAUTHOR_ANALYSIS__NUM_LAYERS=2
COAUTHOR_ANALYSIS__EPOCHS=100
COAUTHOR_ANALYSIS__LEARNING_RATE=0.01

# API settings
COAUTHOR_API__HOST=0.0.0.0
COAUTHOR_API__PORT=8000
COAUTHOR_API__CACHE_TTL=86400
COAUTHOR_API__DEFAULT_TOP_K=20

# Scheduler settings
COAUTHOR_SCHEDULER__CRAWL_CRON_HOUR=2
COAUTHOR_SCHEDULER__ANALYSIS_CRON_DAY=sun
COAUTHOR_SCHEDULER__ANALYSIS_CRON_HOUR=4
